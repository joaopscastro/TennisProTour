# Local development only. Production must use AUTH_MODE=clerk.
AUTH_MODE=development
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_DEV_MANAGER_ID=seed-m1

# Production Clerk configuration.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-to-server tournament administration. Never expose this to the web app.
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-secret

# Exact browser origins allowed to call Fastify.
CORS_ORIGINS=http://localhost:3001

# Dev/test-only: fires the world tick (aging, training, tournament
# generation, ranking — see AdvanceWorldWeekUseCase) every N
# milliseconds instead of WORLD_TICK_CRON's real-week cadence. Leave
# unset for production-like real-week behavior (the default everywhere
# this is unset, including production — NEVER set this in a real
# production environment). 3600000 = 1 hour = 1 game week per real
# hour, a reasonable default for local testing. See README.md's "Fast
# local tick cadence" section.
# WORLD_TICK_INTERVAL_MS=360000
