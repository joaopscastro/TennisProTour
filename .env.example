# Local development only. Production must use AUTH_MODE=clerk.
AUTH_MODE=development
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_DEV_MANAGER_ID=seed-m1

# Production Clerk configuration.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-to-server tournament administration. Never expose this to the web app.
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-secret

# Exact browser origins allowed to call Fastify.
CORS_ORIGINS=http://localhost:3001
