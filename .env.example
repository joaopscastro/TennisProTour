# =============================================================================
# Tennis Manager — environment inventory
#
# One repo-root .env configures every process: apps/api and apps/worker both
# load it via `resolve(__dirname, '../../../.env')`, so there is a single
# source of truth rather than one file per app. Copy to `.env` and fill in.
#
# NEVER commit .env. `.env.example` (this file) is the only committed copy.
# =============================================================================
#
# DEPLOY NOTES (read before the first real deploy)
#
# 1. NEXT_PUBLIC_* are BUILD-TIME. The web Docker target bakes them into the
#    client bundle via `--build-arg`; setting them as runtime env vars on the
#    web container has NO effect. A changed API URL or Clerk key requires a
#    rebuild. (See Dockerfile's `build` stage.)
#
# 2. Run database migrations as a ONE-SHOT release step, from the `migrate`
#    Docker target, BEFORE api/worker start. apps/api and apps/worker share
#    ONE Postgres database; never migrate from the API entrypoint (the API has
#    no business holding migration rights, and two api replicas racing
#    migrations is worse than useless).
#
# 3. apps/api and apps/worker must share ONE `MATCH_LOG_DIR` filesystem (the
#    worker writes replay blobs, the API serves them) AND the same
#    `MATCH_LOG_PUBLIC_BASE_URL` (the base of the URLs returned in simulate
#    responses). A split directory = every auto-simulated replay 404s; that
#    was a real bug this project already hit once.
# =============================================================================


# -----------------------------------------------------------------------------
# SHARED — Postgres + world identity (used by apps/api, apps/worker, migrate)
# -----------------------------------------------------------------------------

# REQUIRED. Postgres connection string. Both apps and the migrate target read
# it. Local default via docker-compose.yml.
DATABASE_URL=postgresql://tennis:tennis@localhost:5432/tennis_manager

# OPTIONAL. Single implicit game-world id at MVP. Ranking reads and the world
# tick must agree on it. Any script operating on a different world MUST set
# this to the same value. Defaults to "main".
# WORLD_ID=main


# -----------------------------------------------------------------------------
# apps/api — HTTP server
# -----------------------------------------------------------------------------

# OPTIONAL. Listen port. Defaults to 3000.
# PORT=3000

# OPTIONAL but recommended. When "production", boots with extra required-config
# checks (CLERK_AUTHORIZED_PARTIES, INTERNAL_ADMIN_TOKEN warnings) and enables
# the `migrate`/runtime production posture.
# NODE_ENV=production

# REQUIRED to serve authenticated requests. "clerk" (production) or
# "development" (local only — accepts the spoofable x-dev-manager-id header).
# FAILS CLOSED: unset or misspelled values resolve to "clerk", never to dev.
AUTH_MODE=development

# REQUIRED when AUTH_MODE=clerk. Clerk backend secret. Server-only; never
# expose to the browser.
CLERK_SECRET_KEY=

# REQUIRED in production when AUTH_MODE=clerk. Comma-separated exact browser
# origins allowed to hold a Clerk session.
CLERK_AUTHORIZED_PARTIES=http://localhost:3001

# REQUIRED in production. Server-to-server secret for tournament-admin routes.
# Never expose this to the web app. Any sufficiently long random string.
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-secret

# OPTIONAL. Comma-separated exact browser origins allowed to call Fastify via
# CORS. Defaults to http://localhost:3001.
CORS_ORIGINS=http://localhost:3001


# -----------------------------------------------------------------------------
# SHARED — replay/match-log storage (apps/api serves, apps/worker writes)
# -----------------------------------------------------------------------------

# OPTIONAL. Absolute path where replay JSON blobs are written (worker) and
# served (api). When unset, both processes resolve the SAME repo-root
# ./data/match-logs regardless of cwd (see matchLogDirectory.ts). A RELATIVE
# value is resolved against the process cwd and reintroduces the cross-process
# split — always use an absolute path. On a multi-container deploy this must be
# a shared/mounted volume.
# MATCH_LOG_DIR=/absolute/path/to/match-logs

# OPTIONAL. Base URL used to build replay URLs returned in simulate responses.
# Defaults to http://localhost:<PORT>/match-logs. In production point this at
# whatever serves MATCH_LOG_DIR. Both api and worker should agree on it.
# MATCH_LOG_PUBLIC_BASE_URL=https://example.com/match-logs


# -----------------------------------------------------------------------------
# apps/api + apps/worker — world tick schedule
# -----------------------------------------------------------------------------

# OPTIONAL. Cron expression for the one game-DAY-per-firing world tick
# (aging/training/match simulation/tournament generation/ranking). Defaults to
# '0 3 * * *' (daily 03:00) and is only used when WORLD_TICK_INTERVAL_MS is
# unset. apps/api recomputes the next-tick countdown from the SAME value via
# cron-parser, so an override must be identical in BOTH processes or
# /world/clock will show the wrong countdown. NOTE: a sub-daily cron cannot
# compress the clock — the day tick's idempotency key hashes to the UTC date,
# so a second same-day firing is refused as a duplicate. Use interval mode.
# WORLD_TICK_CRON=0 3 * * *

# RECOMMENDED (production mechanism for a compressed world clock). Fires the
# world tick every N milliseconds instead of the WORLD_TICK_CRON cadence
# (N = ms per game DAY; a game week is 7 ticks). This is how the ship clock
# runs: WORLD_TICK_INTERVAL_MS=7200000 makes one game day = 2 real hours
# (~30 real days per season). Unset = the daily cron above.
#
# CRITICAL: it MUST be set IDENTICALLY on BOTH apps/worker (which schedules
# the tick) and apps/api (whose /world/clock countdown recomputes it). If only
# one process sees it, the UI falls back to projecting the daily cron and the
# world-stale threshold silently becomes 48h — everything still "works", just
# on a mismatched invisible clock. Both logs print the resolved cadence at
# boot; diff them when in doubt. See README.md's "World tick cadence" section.
# WORLD_TICK_INTERVAL_MS=7200000


# -----------------------------------------------------------------------------
# apps/api + apps/worker — Notifications (email digest)
# -----------------------------------------------------------------------------
#
# FAILS OFF, not closed. Unlike AUTH_MODE (which defaults to the safe,
# spoof-resistant "clerk"), NOTIFICATIONS fail OFF: an unset/empty mode means
# the digest scheduler is never registered and no email can ever be sent. This
# is the safe direction for an outbound integration — a half-wired deploy
# stays silent rather than blasting mail.

# OPTIONAL. "off" (default) | "log" | "resend".
#   off    = digest scheduler not registered at all (fail-safe).
#   log    = scheduler runs, but the transport only logs {to, subject} and
#            contacts nothing (dev/tests). No real email is ever sent.
#   resend = real delivery via Resend over global fetch (no new dependency).
NOTIFICATION_EMAIL_MODE=off

# REQUIRED when NOTIFICATION_EMAIL_MODE=resend. apps/api throws at boot if
# this is unset in resend mode (same loud-misconfiguration style as
# CLERK_SECRET_KEY); apps/worker would otherwise build a failing transport.
RESEND_API_KEY=

# OPTIONAL (resend mode). The From header Resend sends as.
# NOTIFICATION_FROM_EMAIL=Tennis Manager <digest@yourdomain.example>

# OPTIONAL (resend mode). PUBLIC base URL of the API that serves
# GET /notifications/unsubscribe — used to build the footer link. Defaults to
# http://localhost:<PORT>. Trailing slashes are tolerated. This is the API's
# public base, not the web app: the link must reach the API route directly.
# NOTIFICATION_APP_BASE_URL=https://api.yourdomain.example

# OPTIONAL. HMAC secret for signing unsubscribe links. When unset, the
# unsubscribe footer is omitted from emails AND the unsubscribe route 404s —
# no dead links. Set a long random string in production to enable one-click
# unsubscribe (the digest is ON by default, so this is how a manager gets out
# of an email they never asked for).
# NOTIFICATION_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

# OPTIONAL (apps/worker). How often the digest job fires, in ms. Default
# 86400000 (daily). Only relevant when NOTIFICATION_EMAIL_MODE is not "off".
# NOTIFICATION_DIGEST_INTERVAL_MS=86400000


# -----------------------------------------------------------------------------
# apps/worker — background jobs
# -----------------------------------------------------------------------------

# REQUIRED. Redis connection string for BullMQ (the world-tick scheduler and
# the job workers). Local default via docker-compose.yml.
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# apps/api — Billing (Stripe, behind BillingPort)
# -----------------------------------------------------------------------------

# OPTIONAL. Omit locally — entitlement reads still work against the local
# table; checkout/webhook calls fail loudly until real keys are set.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_SUCCESS_URL=http://localhost:3001/billing/success
# BILLING_CANCEL_URL=http://localhost:3001/billing/cancel


# -----------------------------------------------------------------------------
# apps/web — build-time (NEXT_PUBLIC_* are INLINED; see deploy note 1)
# -----------------------------------------------------------------------------

# OPTIONAL. Base URL of the Fastify API the browser calls. Build-time.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# OPTIONAL. When set, the app requires a real Clerk sign-in (AuthGate) and
# sends bearer tokens. When unset, the local dev-manager header path is used.
# Build-time.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# OPTIONAL/INFORMATIONAL. Mirrors AUTH_MODE for the client build. The runtime
# switch is NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY above; this is kept for
# deploy-time visibility only. Build-time.
NEXT_PUBLIC_AUTH_MODE=development

# DEV ONLY — NEVER SET IN PRODUCTION. Seed manager id the local frontend
# auto-fills into its manager-id input so `npm run dev` is usable immediately.
# Production identity comes from Clerk. Build-time (but must not be built into
# a production bundle).
NEXT_PUBLIC_DEV_MANAGER_ID=seed-m1


# -----------------------------------------------------------------------------
# apps/api — test-only and seed/utility scripts
# -----------------------------------------------------------------------------

# TEST ONLY. Connection string for the isolated test database. The test
# suites NEVER read DATABASE_URL, and refuse to run if this points at the dev
# database name. Defaults to tennis_manager_test.
# TEST_DATABASE_URL=postgresql://tennis:tennis@localhost:5432/tennis_manager_test

# SEED SCRIPT ONLY. Base URL the seed prints for browser links.
# WEB_BASE_URL=http://localhost:3001

# GENESIS SCRIPT ONLY. Override the fill-only genesis population size.
# GENESIS_POPULATION=300
