{
  "name": "@tennis-manager/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "scripts": {
    "build": "tsc --build",
    "start": "tsc --build && node dist/index.js",
    "seed": "tsc --build && node dist/scripts/seed.js",
    "genesis-seed": "tsc --build && node dist/scripts/genesisSeedFillOnlyPlayers.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@tennis-manager/application": "^0.1.0",
    "@tennis-manager/domain": "^0.1.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10"
  }
}
