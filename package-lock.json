{
  "name": "tennis-manager",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tennis-manager",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "typescript": "^5.6.0"
      }
    },
    "apps/api": {
      "name": "@tennis-manager/api",
      "version": "0.1.0",
      "dependencies": {
        "@tennis-manager/application": "^0.1.0",
        "@tennis-manager/domain": "^0.1.0"
      }
    },
    "apps/web": {
      "name": "@tennis-manager/web",
      "version": "0.1.0"
    },
    "apps/worker": {
      "name": "@tennis-manager/worker",
      "version": "0.1.0",
      "dependencies": {
        "@tennis-manager/application": "^0.1.0",
        "@tennis-manager/domain": "^0.1.0"
      }
    },
    "node_modules/@tennis-manager/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@tennis-manager/application": {
      "resolved": "packages/application",
      "link": true
    },
    "node_modules/@tennis-manager/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@tennis-manager/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@tennis-manager/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/application": {
      "name": "@tennis-manager/application",
      "version": "0.1.0",
      "dependencies": {
        "@tennis-manager/domain": "^0.1.0"
      }
    },
    "packages/domain": {
      "name": "@tennis-manager/domain",
      "version": "0.1.0"
    }
  }
}
